{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gogogadget",
  "version": "0.1.3",
  "identifier": "dev.gogogadget.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gogogadget",
        "width": 760,
        "height": 540,
        "minWidth": 600,
        "minHeight": 430,
        "decorations": false,
        "resizable": true,
        "center": true,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "A fast, modular AI launcher",
    "category": "Productivity"
  }
}
